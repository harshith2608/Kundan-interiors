# ── Required ──────────────────────────────────────────────────────────────────
# A long random string — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# PostgreSQL connection URL (Supabase / Neon / Render Postgres)
# Leave blank to use SQLite locally
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "production" when deploying
FLASK_ENV=production

# ── Razorpay (optional — for payment tracking) ────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Email Notifications (optional — configured via Admin → Settings) ──────────
# SMTP settings are stored in the database via the Admin panel.
# No env vars needed for email.
